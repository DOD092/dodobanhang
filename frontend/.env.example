# Copy thành .env.local rồi sửa nếu backend chạy ở chỗ khác.
# URL gốc của API backend (NestJS, có tiền tố /api). Tiền tố NEXT_PUBLIC_ vì form liên hệ gọi từ
# trình duyệt; giá trị được nhúng lúc build nên đổi thì phải chạy lại `npm run dev` / `npm run build`.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Client ID OAuth của Google (công khai) - PHẢI giống GOOGLE_CLIENT_ID ở backend/.env.
# Google Cloud Console > OAuth client > "Authorized JavaScript origins" phải có http://localhost:3001
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
