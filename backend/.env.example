NODE_ENV=development
PORT=3000

# Postgres. Với DB cloud (Aiven/Neon/Supabase) dùng host + port do nhà cung cấp
# cấp; SSL tự bật khi host khác localhost.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=dodobanhang

# Tuỳ chọn: ép bật/tắt SSL (mặc định: bật khi host khác localhost)
# DB_SSL=true
# Tuỳ chọn: nội dung file ca.pem của Aiven. Có giá trị này thì chứng chỉ server
# mới được xác thực đầy đủ (rejectUnauthorized: true).
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# JWT. Đổi JWT_SECRET thành chuỗi ngẫu nhiên riêng cho mỗi môi trường, không commit giá trị thật.
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Google OAuth — lấy ở Google Cloud Console > APIs & Services > Credentials.
# GOOGLE_CALLBACK_URL phải khai báo y hệt trong "Authorized redirect URIs".
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Gửi email qua Gmail SMTP. MAIL_PASSWORD là App Password 16 ký tự
# (myaccount.google.com/apppasswords, cần bật xác minh 2 bước) — KHÔNG phải mật khẩu Gmail.
# Bỏ trống MAIL_USER/MAIL_PASSWORD thì email chỉ được log ra console.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Dodobanhang <your-account@gmail.com>"
# Hộp thư nhận cảnh báo khi server lỗi 5xx. Bỏ trống = không gửi cảnh báo.
ALERT_EMAIL=
# Hộp thư công ty nhận tin nhắn form Liên hệ trên web (POST /api/contacts).
# Bỏ trống = tin nhắn chỉ được log ra console.
CONTACT_EMAIL=

# true = lúc boot nạp 5 nhóm + 13 sản phẩm thật cho web bán hàng (idempotent, đã có thì bỏ qua).
# DB dùng chung cả nhóm: chỉ bật 1 lần khi cần rồi tắt lại. Xem backend.md mục 7.
SEED_CATALOG=false
# Nạp sản phẩm giả lập từ crawl Tiki (data/products.jsonl). CHỈ dùng ở DB test/local, không bật trên Aiven.
# TIKI_DATA_FILE (mặc định ../data/products.jsonl), TIKI_SEED_LIMIT, TIKI_CATEGORY_SLUG (ép vào 1 nhóm)
# TIKI_CATEGORY_MODE=tree (cây danh mục Tiki, mặc định) | map (5 nhóm), TIKI_CATEGORY_SKIP=1, TIKI_CATEGORY_DEPTH=2
SEED_TIKI=false

# PayOS (my.payos.vn -> Kênh thanh toán). KHÔNG commit giá trị thật.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Trang frontend PayOS chuyển người dùng về sau khi thanh toán (returnUrl / cancelUrl)
FRONTEND_URL=http://localhost:3001
