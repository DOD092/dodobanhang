NODE_ENV=development
PORT=3000

# Postgres. Với DB cloud (Aiven/Neon/Supabase) dùng host + port do nhà cung cấp
# cấp; SSL tự bật khi host khác localhost.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=dodobanhang

# Tuỳ chọn: ép bật/tắt SSL (mặc định: bật khi host khác localhost)
# DB_SSL=true
# Tuỳ chọn: nội dung file ca.pem của Aiven. Có giá trị này thì chứng chỉ server
# mới được xác thực đầy đủ (rejectUnauthorized: true).
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# JWT. Đổi JWT_SECRET thành chuỗi ngẫu nhiên riêng cho mỗi môi trường, không commit giá trị thật.
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
